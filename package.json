{
	"name": "@obelism/sdk",
	"author": "Obelism <hello@obelism.studio> (https://www.obelism.studio)",
	"license": "MIT",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"test": "turbo run test",
		"test:ci": "turbo run test:ci",
		"lint-staged": "lint-staged",
		"clean": "turbo run clean",
		"format": "prettier --write --ignore-unknown .",
		"format:check": "prettier --check --ignore-unknown .",
		"changeset": "changeset",
		"version": "changeset version",
		"publish-packages": "turbo run build && turbo run lint test:ci && changeset publish",
		"workspace:list": "npm query .workspace | jq -r '.[].location'"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@vercel/git-hooks": "^1.0.0",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.1",
		"turbo": "^2.11.8",
		"typescript": "^7.0.2"
	},
	"git": {
		"pre-commit": "lint-staged"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "npm@11.17.0",
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"allowScripts": {
		"@vercel/git-hooks@1.0.0": true
	}
}
