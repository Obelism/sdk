# Space settings → API tokens. A delivery token for the environment this
# site shows. Drafts need no token here: the visual editor adds one for the
# person editing (cms_token), and editing on the site signs in (/cms/login).
CONTENT_DELIVERY_TOKEN=cms_d_…

# Editing on the site (/cms/login): the space's id and the environment the
# tokens above belong to. Its preview URL in Space settings must be on this
# site's origin.
CONTENT_SPACE_ID=space_…
CONTENT_ENVIRONMENT=production

# Only when not using https://content.obelism.studio
# NEXT_PUBLIC_CONTENT_URL=https://content.obelism.studio

# Optional: your own model for prompt editing (src/app/api/content-prompt).
# CONTENT_PROMPT_SECRET=whsec_…
# ANTHROPIC_API_KEY=sk-ant-…
