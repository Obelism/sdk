# Worker environment. Copy to `.env` for `npm run dev`; on Oxygen, add the
# same names under Storefront settings → Environments and variables.
#
# Mode is auto-detected: with a Storefront API token the app reads your store;
# with none it falls back to the tokenless mock.shop demo.

# Shopify. A private token is server-only; a public token can read the
# published catalogue from server code too (this example uses one).
PUBLIC_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=
# PRIVATE_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=

# Customer Accounts (real store only, over HTTPS). Set all three to enable
# /account. A linked storefront injects these on Oxygen.
# SHOP_ID=
# PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
# SESSION_SECRET=

# Obelism Content. Settings → API tokens, per environment. A deployment keeps
# the variables it was deployed with: rotating a token needs a redeploy.
CONTENT_DELIVERY_TOKEN=
CONTENT_SPACE_ID=
CONTENT_ENVIRONMENT=production

# Obelism Improve and numbers. Same space and environment as Content. The
# server SDK and numbers' server events use the API token; the browser uses the
# organization and space ids, and the storefront's origin must be allowed.
IMPROVE_ORGANIZATION_ID=
IMPROVE_SPACE_ID=
IMPROVE_ENVIRONMENT=production
IMPROVE_API_TOKEN=

NUMBERS_ORGANIZATION_ID=
NUMBERS_SPACE_ID=
NUMBERS_ENVIRONMENT=production
NUMBERS_API_TOKEN=
