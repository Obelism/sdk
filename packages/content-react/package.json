{
	"name": "@obelism/content-react",
	"description": "Obelism Content React SDK: live preview in the visual editor and rich text",
	"version": "0.4.2",
	"keywords": [
		"cms",
		"headless-cms",
		"visual-editor",
		"typescript",
		"obelism",
		"react"
	],
	"license": "MIT",
	"author": "Obelism <hello@obelism.studio> (https://www.obelism.studio)",
	"repository": {
		"type": "git",
		"url": "https://github.com/Obelism/sdk",
		"directory": "packages/content-react"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bunchee",
		"dev": "bunchee --watch --no-clean",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ci": "vitest run",
		"lint": "npm-run-all --parallel lint:*",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc --noEmit",
		"clean": "rm -rf ./node_modules && rm -rf ./dist && rm -rf ./.turbo"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"dependencies": {
		"@obelism/content": "^0.22.0"
	},
	"devDependencies": {
		"@obelism/sdk-typescript-config": "^0.0.0",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.2.4",
		"@typescript/typescript6": "^6.0.2",
		"bunchee": "^7.0.2",
		"jsdom": "^30.1.2",
		"npm-run-all2": "^9.0.2",
		"oxlint": "^1.89.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.4"
	}
}
