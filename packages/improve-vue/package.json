{
	"name": "@obelism/improve-sdk-vue",
	"description": "Obelism Improve Vue SDK: a provider and composables for A/B tests and feature flags in Vue and Nuxt",
	"version": "0.1.0",
	"keywords": [
		"ab-tests",
		"feature-flags",
		"typescript",
		"improve",
		"vue",
		"nuxt"
	],
	"license": "MIT",
	"author": "Obelism <hello@obelism.studio> (https://www.obelism.studio)",
	"repository": {
		"type": "git",
		"url": "https://github.com/Obelism/sdk",
		"directory": "packages/improve-vue"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bunchee -m",
		"dev": "bunchee --watch --no-clean",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ci": "vitest run",
		"lint": "npm-run-all --parallel lint:*",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc --noEmit",
		"clean": "rm -rf ./node_modules && rm -rf ./dist && rm -rf ./.turbo"
	},
	"peerDependencies": {
		"vue": ">=3.3.0"
	},
	"dependencies": {
		"@obelism/improve-sdk": "^3.7.0"
	},
	"devDependencies": {
		"@obelism/sdk-typescript-config": "^0.0.0",
		"@typescript/typescript6": "^6.0.2",
		"@vue/test-utils": "^2.5.1",
		"bunchee": "^7.0.2",
		"jsdom": "^30.1.3",
		"npm-run-all2": "^9.0.4",
		"oxlint": "^1.93.0",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0",
		"vue": "^3.5.45"
	}
}
