{
	"name": "@obelism/improve-sdk",
	"description": "Obelism Improve SDK",
	"version": "3.2.0",
	"keywords": [
		"ab-tests",
		"feature-flags",
		"typescript",
		"improve"
	],
	"license": "MIT",
	"author": "Obelism <hello@obelism.studio> (https://www.obelism.studio)",
	"repository": {
		"type": "git",
		"url": "https://github.com/Obelism/sdk",
		"directory": "packages/improve"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.mjs",
			"require": "./dist/server.cjs"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.mjs",
			"require": "./dist/client.cjs"
		},
		"./types": {
			"types": "./dist/types.d.ts"
		},
		"./oidc": {
			"types": "./dist/oidc.d.ts",
			"import": "./dist/oidc.mjs",
			"require": "./dist/oidc.cjs"
		}
	},
	"typesVersions": {
		"*": {
			"server": [
				"./dist/server.d.ts"
			],
			"client": [
				"./dist/client.d.ts"
			],
			"types": [
				"./dist/types.d.ts"
			]
		}
	},
	"scripts": {
		"build": "bunchee -m",
		"dev": "bunchee --watch --no-clean",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ci": "vitest run",
		"lint": "npm-run-all --parallel lint:*",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc --noEmit",
		"clean": "rm -rf ./node_modules && rm -rf ./dist && rm -rf ./.turbo"
	},
	"dependencies": {
		"@obelism/numbers-sdk": "^0.2.0"
	},
	"peerDependencies": {
		"ua-parser-js": "^2.0.0",
		"@vercel/oidc": "^4.0.0"
	},
	"devDependencies": {
		"@obelism/sdk-typescript-config": "^0.0.0",
		"@typescript/typescript6": "^6.0.2",
		"@vercel/oidc": "4.0.0",
		"bunchee": "^7.0.2",
		"jsdom": "^30.1.2",
		"npm-run-all2": "^9.0.2",
		"oxlint": "^1.88.0",
		"typescript": "^7.0.2",
		"ua-parser-js": "^2.0.10",
		"vitest": "^5.0.4"
	},
	"peerDependenciesMeta": {
		"@vercel/oidc": {
			"optional": true
		}
	}
}
