{
	"name": "@obelism/improve-sdk-react",
	"description": "Obelism Improve React SDK",
	"version": "1.1.1",
	"keywords": [
		"ab-tests",
		"feature-flags",
		"typescript",
		"improve",
		"react"
	],
	"license": "MIT",
	"author": "Obelism <hello@obelism.studio> (https://www.obelism.studio)",
	"repository": {
		"type": "git",
		"url": "https://github.com/Obelism/sdk",
		"directory": "packages/improve-react"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bunchee -m",
		"dev": "bunchee --watch --no-clean",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ci": "vitest run",
		"lint": "npm-run-all --parallel lint:*",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc --noEmit",
		"clean": "rm -rf ./node_modules && rm -rf ./dist && rm -rf ./.turbo"
	},
	"devDependencies": {
		"@obelism/sdk-typescript-config": "^0.0.0",
		"@types/react": "^19.2.17",
		"@typescript/typescript6": "^6.0.2",
		"bunchee": "^7.0.2",
		"npm-run-all2": "^9.0.2",
		"oxlint": "^1.88.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.4"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"dependencies": {
		"@obelism/improve-sdk": "^3.0.0"
	}
}
