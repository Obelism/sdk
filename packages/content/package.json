{
	"name": "@obelism/content",
	"description": "Obelism Content SDK: the delivery API client, the visual editor bridge with prompt editing, editing on your own site, webhook verification, and the content model CLI",
	"version": "0.27.2",
	"keywords": [
		"cms",
		"headless-cms",
		"visual-editor",
		"typescript",
		"obelism"
	],
	"license": "MIT",
	"author": "Obelism <hello@obelism.studio> (https://www.obelism.studio)",
	"repository": {
		"type": "git",
		"url": "https://github.com/Obelism/sdk",
		"directory": "packages/content"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"bin": {
		"content": "./dist/bin/content.js"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./bridge": {
			"import": {
				"types": "./dist/bridge.d.mts",
				"default": "./dist/bridge.mjs"
			},
			"require": {
				"types": "./dist/bridge.d.ts",
				"default": "./dist/bridge.js"
			}
		},
		"./site": {
			"import": {
				"types": "./dist/site.d.mts",
				"default": "./dist/site.mjs"
			},
			"require": {
				"types": "./dist/site.d.ts",
				"default": "./dist/site.js"
			}
		},
		"./prompt": {
			"import": {
				"types": "./dist/prompt.d.mts",
				"default": "./dist/prompt.mjs"
			},
			"require": {
				"types": "./dist/prompt.d.ts",
				"default": "./dist/prompt.js"
			}
		},
		"./webhooks": {
			"import": {
				"types": "./dist/webhooks.d.mts",
				"default": "./dist/webhooks.mjs"
			},
			"require": {
				"types": "./dist/webhooks.d.ts",
				"default": "./dist/webhooks.js"
			}
		},
		"./oidc": {
			"import": {
				"types": "./dist/oidc.d.mts",
				"default": "./dist/oidc.mjs"
			},
			"require": {
				"types": "./dist/oidc.d.ts",
				"default": "./dist/oidc.js"
			}
		}
	},
	"scripts": {
		"build": "bunchee && rollup --config rollup.bridge.config.mjs",
		"dev": "bunchee --watch --no-clean",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ci": "vitest run",
		"lint": "npm-run-all --parallel lint:*",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc --noEmit",
		"clean": "rm -rf ./node_modules && rm -rf ./dist && rm -rf ./.turbo"
	},
	"devDependencies": {
		"@obelism/sdk-typescript-config": "^0.0.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@types/node": "^26.6.5",
		"@typescript/typescript6": "^6.0.2",
		"@vercel/oidc": "4.0.4",
		"bunchee": "^7.0.2",
		"jsdom": "^30.1.3",
		"npm-run-all2": "^9.0.4",
		"oxlint": "^1.90.0",
		"rollup": "^4.65.1",
		"rollup-plugin-swc3": "^0.12.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=20"
	},
	"peerDependencies": {
		"@vercel/oidc": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@vercel/oidc": {
			"optional": true
		}
	}
}
