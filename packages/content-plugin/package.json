{
	"name": "@obelism/content-plugin",
	"description": "Build Obelism Content plugins: a field's input or a dashboard page in a frame, and verifying their context tokens",
	"version": "0.1.0",
	"keywords": [
		"cms",
		"headless-cms",
		"plugin",
		"obelism"
	],
	"license": "MIT",
	"author": "Obelism <hello@obelism.studio> (https://www.obelism.studio)",
	"repository": {
		"type": "git",
		"url": "https://github.com/Obelism/sdk",
		"directory": "packages/content-plugin"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react.d.mts",
				"default": "./dist/react.mjs"
			},
			"require": {
				"types": "./dist/react.d.ts",
				"default": "./dist/react.js"
			}
		},
		"./server": {
			"import": {
				"types": "./dist/server.d.mts",
				"default": "./dist/server.mjs"
			},
			"require": {
				"types": "./dist/server.d.ts",
				"default": "./dist/server.js"
			}
		}
	},
	"scripts": {
		"build": "bunchee",
		"dev": "bunchee --watch --no-clean",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ci": "vitest run",
		"lint": "npm-run-all --parallel lint:*",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc --noEmit",
		"clean": "rm -rf ./node_modules && rm -rf ./dist && rm -rf ./.turbo"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"dependencies": {
		"jose": "^6.2.12"
	},
	"devDependencies": {
		"@obelism/sdk-typescript-config": "^0.0.0",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/typescript6": "^6.0.2",
		"bunchee": "^7.0.2",
		"jsdom": "^30.1.3",
		"npm-run-all2": "^9.0.4",
		"oxlint": "^1.89.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
